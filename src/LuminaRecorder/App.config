<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Per-monitor DPI support for WPF on .NET Framework 4.8 -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false;Switch.System.Windows.Forms.DoNotSupportSelectAllShortcutInMultilineTextBox=false" />
  </runtime>
</configuration>
