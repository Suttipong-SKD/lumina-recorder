<Window x:Class="LuminaRecorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina Recorder" Icon="/Assets/app.ico"
        Width="1120" Height="720" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Text}"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Background="{StaticResource Chrome}" BorderBrush="#1F242D" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Stroke="{StaticResource Rec}" StrokeThickness="2"/>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource Rec}"/>
                        </Grid>
                        <TextBlock Text="Lumina Recorder" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" ToolTip="ตั้งค่า" AutomationProperties.Name="ตั้งค่า"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnSettings_Click">
                            <Path Data="{StaticResource IconGear}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnMinimize" Style="{StaticResource IconButton}" ToolTip="ย่อหน้าต่าง" AutomationProperties.Name="ย่อหน้าต่าง"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMinimize_Click">
                            <Rectangle Width="11" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" ToolTip="ปิด" AutomationProperties.Name="ปิด"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnClose_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left: mode + monitor map + actions -->
                <Grid Margin="24,22,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="12" Padding="5" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeFull" Style="{StaticResource SegmentTab}" GroupName="Mode" Content="เต็มจอ" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeRegion" Style="{StaticResource SegmentTab}" GroupName="Mode" Content="เลือกพื้นที่" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeWindow" Style="{StaticResource SegmentTab}" GroupName="Mode" Content="หน้าต่างโปรแกรม" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeAll" Style="{StaticResource SegmentTab}" GroupName="Mode" Content="ทุกจอพร้อมกัน" Checked="Mode_Checked"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,18,0,18" Background="#13161C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="#1F242D" BorderThickness="0,0,0,1" Padding="18,12">
                                <Grid>
                                    <TextBlock x:Name="MapTitle" Text="เลือกจอที่จะอัด" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}"/>
                                    <TextBlock x:Name="MapHint" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </Border>

                            <Grid x:Name="MapHost" Grid.Row="1" Margin="18" ClipToBounds="True" SizeChanged="MapHost_SizeChanged">
                                <Canvas x:Name="MonitorCanvas"/>
                                <!-- Window mode overlay -->
                                <StackPanel x:Name="WindowPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Visibility="Collapsed">
                                    <TextBlock Text="เลือกหน้าต่างโปรแกรมที่จะอัด" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="WindowBox" Height="40" SelectionChanged="WindowBox_SelectionChanged"/>
                                        <Button x:Name="BtnRefreshWindows" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,0"
                                                ToolTip="รีเฟรชรายชื่อหน้าต่าง" AutomationProperties.Name="รีเฟรชรายชื่อหน้าต่าง" Click="BtnRefreshWindows_Click">
                                            <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource Text}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="อัดได้แม้หน้าต่างถูกบังหรืออยู่คนละจอ (Windows 10 เวอร์ชัน 2004 ขึ้นไป)" Margin="0,10,0,0"
                                               FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" BorderBrush="#1F242D" BorderThickness="0,1,0,0" Padding="18,10">
                                <DockPanel LastChildFill="False">
                                    <StackPanel x:Name="RegionPanel" Orientation="Horizontal" DockPanel.Dock="Left" Visibility="Collapsed">
                                        <ComboBox x:Name="RegionPresetBox" Width="170" SelectionChanged="RegionPresetBox_SelectionChanged"/>
                                        <Button x:Name="BtnSelectRegion" Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0" Content="ลากเลือกพื้นที่ใหม่" Click="BtnSelectRegion_Click"/>
                                        <TextBlock x:Name="RegionInfo" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <CheckBox x:Name="CursorCheck" Style="{StaticResource Switch}" Content="แสดงเคอร์เซอร์" FontSize="13" Margin="0,0,18,0" Click="Option_Changed"/>
                                        <CheckBox x:Name="ClicksCheck" Style="{StaticResource Switch}" Content="ไฮไลต์คลิก" FontSize="13" Click="Option_Changed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button x:Name="BtnRecord" Style="{StaticResource RecordButton}" Click="BtnRecord_Click" AutomationProperties.Name="เริ่มอัด">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RecordText" Text="เริ่มอัด" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KeyChip}">
                                    <TextBlock x:Name="RecordKey" Text="F9" FontSize="12" FontWeight="Medium" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnScreenshot" Style="{StaticResource TallButton}" Margin="14,0,0,0" Click="BtnScreenshot_Click" AutomationProperties.Name="จับภาพหน้าจอ">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCamera}" Stroke="{StaticResource Text}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="จับภาพหน้าจอ" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KeyChip}" Background="{StaticResource Surface3}">
                                    <TextBlock x:Name="ShotKey" Text="F11" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Muted}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Muted}" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="260"/>
                    </DockPanel>
                </Grid>

                <!-- Right: audio / video / recent -->
                <Border Grid.Column="1" Background="{StaticResource Chrome}" BorderBrush="#1F242D" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,22,22,22">

                            <TextBlock Text="เสียง" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="SysAudioCheck" Style="{StaticResource Switch}" Content="เสียงในเครื่อง" Click="Audio_Changed"/>
                                    <Grid Height="6" Margin="0,10,0,10">
                                        <Border Background="{StaticResource Surface3}" CornerRadius="3"/>
                                        <Border x:Name="SysMeter" Background="{StaticResource Ok}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                    <ComboBox x:Name="SpeakerBox" SelectionChanged="Device_Changed"/>

                                    <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,14"/>

                                    <CheckBox x:Name="MicCheck" Style="{StaticResource Switch}" Content="ไมโครโฟน" Click="Audio_Changed"/>
                                    <Grid Height="6" Margin="0,10,0,10">
                                        <Border Background="{StaticResource Surface3}" CornerRadius="3"/>
                                        <Border x:Name="MicMeter" Background="{StaticResource Ok}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                    <ComboBox x:Name="MicBox" SelectionChanged="Device_Changed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="วิดีโอ" Style="{StaticResource SectionLabel}" Margin="2,20,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="รูปแบบไฟล์" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/>
                                <ComboBox x:Name="FormatBox" Grid.Row="1" SelectionChanged="Video_Changed"/>
                                <TextBlock Grid.Column="2" Text="เฟรมเรต" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/>
                                <ComboBox x:Name="FpsBox" Grid.Column="2" Grid.Row="1" SelectionChanged="Video_Changed"/>
                                <TextBlock Grid.Row="3" Text="คุณภาพ" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/>
                                <ComboBox x:Name="QualityBox" Grid.Row="4" SelectionChanged="Video_Changed"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="กล้องเว็บแคม" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/>
                                <ComboBox x:Name="WebcamBox" Grid.Row="4" Grid.Column="2" SelectionChanged="Video_Changed"/>
                            </Grid>
                            <TextBlock x:Name="HwText" Margin="2,10,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="ใช้การ์ดจอช่วยเข้ารหัส (NVIDIA / AMD / Intel) อัตโนมัติ ไฟล์เล็กและไม่กินเครื่อง"/>

                            <DockPanel Margin="2,22,0,8">
                                <TextBlock Text="ไฟล์ล่าสุด" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <Button x:Name="BtnOpenFolder" Style="{StaticResource LinkButton}" Content="เปิดโฟลเดอร์" HorizontalAlignment="Right" Click="BtnOpenFolder_Click"/>
                            </DockPanel>
                            <StackPanel x:Name="RecentList"/>
                            <TextBlock x:Name="RecentEmpty" Text="ยังไม่มีไฟล์ กด เริ่มอัด เพื่อบันทึกวิดีโอแรก" FontSize="12"
                                       Foreground="{StaticResource Muted}" Margin="2,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Toast -->
            <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,340,96"
                    Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                    Padding="16,10" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="13"/>
            </Border>
        </Grid>
    </Border>
</Window>
